<Project Sdk="Microsoft.NET.Sdk">

  <!-- For IDEs (Visual Studio, Rider, VS Code). Official builds use build.ps1. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>OpacityBar</AssemblyName>
    <RootNamespace>OpacityBar</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>src\app.manifest</ApplicationManifest>
    <LangVersion>5</LangVersion>
    <Optimize>true</Optimize>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <NoWarn>420</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The installer is a separate exe (see build.ps1). -->
    <Compile Remove="installer\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
